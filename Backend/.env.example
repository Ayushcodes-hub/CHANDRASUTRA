# Environment Variables — LUNARIS Backend
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is git-ignored.

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# ─── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
REPORTS_DIR=./reports

# ─── Server ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Compute ───────────────────────────────────────────────────────────────────
# Set to true only if a CUDA GPU is available and you want to use it.
GPU_ENABLED=false

# ─── Models ────────────────────────────────────────────────────────────────────
# Directory where model weights are cached (LoFTR, etc.)
# Leave empty to use the default torch/kornia cache (~/.cache/kornia)
MODEL_CACHE_DIR=

# ─── LoFTR ─────────────────────────────────────────────────────────────────────
# Pretrained weights variant: "outdoor" (lunar surface) or "indoor"
LOFTR_PRETRAINED=outdoor

# ─── Local Supabase (docker-compose.supabase.yml) ──────────────────────────────
# Only used by docker-compose.supabase.yml itself, to sign the Studio dashboard's
# session keys. The FastAPI app never reads these — it only reads DATABASE_URL above.
SUPABASE_JWT_SECRET=e37c62908fb6434c7e88627d92149f870259a62d399e447f929f21619fdf9b22
