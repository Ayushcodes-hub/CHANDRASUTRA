generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// LUNARMATCH 2.0 — DEEP SPACE TELEMETRY PERSISTENCE
// ─────────────────────────────────────────────────────────────

// One registered orbit pass (CH-2 TMC-2 ⇌ OHRC registration cycle)
model OrbitPass {
  id            String   @id @default(cuid())
  passId        String   @unique // PASS-0498
  epoch         String // 2024-10-28 14:22:09 UTC
  siteName      String // SHACKLETON S-POLE
  lat           String // 89.90° S
  lon           String // 000.00° E
  sensorA       String // TMC-2
  sensorB       String // OHRC
  inlierRatio   Float // 98.9
  inliersMatched Int // 3851
  inliersTotal   Int // 3894
  rmse          Float // 0.11
  psnr          Float // +12.64
  ssim          Float // 0.994
  status        String   @default("LOCKED") // LOCKED | REVIEW | FLAGGED
  flagged       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// Operational incident log entries (DSN ops flags)
model Incident {
  id        String   @id @default(cuid())
  passRef   String // PASS-0487
  severity  String   @default("WARN") // WARN | CRIT | INFO
  tag       String // [SOLAR EL 4.2°]
  title     String // SHACKLETON PSR
  body      String // narrative
  createdAt DateTime @default(now())
}

// Pipeline benchmark runs (convergence accuracy over time)
model PipelineRun {
  id            String   @id @default(cuid())
  expId         String @unique // EXP-0400
  label         String // INIT / MID / CURRENT
  meanRmse      Float // 0.45
  runsLogged    Int // 412
  nominalConv   Float // 97.4
  createdAt     DateTime @default(now())
}

// VLM intel reports generated by the LLM terrain analyst
model VlmIntel {
  id        String   @id @default(cuid())
  module    String // orbital | photometric | elevation | archive | dem
  siteName  String
  headline  String
  body      String
  createdAt DateTime @default(now())
}
